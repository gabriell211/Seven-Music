{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.expo/**,android/**,ios/**,assets/**,app/**,src/**,.github/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
